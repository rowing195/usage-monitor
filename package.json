{
  "name": "usage-monitor",
  "version": "0.10.0",
  "private": true,
  "description": "Floating orb showing Claude, Antigravity and OpenAI Codex quota headroom",
  "author": "ian",
  "license": "MIT",
  "main": "src/main/index.js",
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "install-statusline": "node scripts/install-statusline.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.usagemonitor.orb",
    "productName": "Usage Monitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*",
          "!install-statusline.js"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName} ${version} Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName} ${version} Portable.${ext}"
    }
  }
}
